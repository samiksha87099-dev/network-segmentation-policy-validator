{
  "rules": [
    {
      "rule_id": "FW-001",
      "source_zone": "Internet",
      "destination_zone": "DMZ",
      "protocol": "TCP",
      "source_port": "ANY",
      "destination_port": "443",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 10,
      "description": "Allow HTTPS from Internet to DMZ web servers",
      "enabled": true
    },
    {
      "rule_id": "FW-002",
      "source_zone": "Internet",
      "destination_zone": "DMZ",
      "protocol": "TCP",
      "source_port": "ANY",
      "destination_port": "80",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 11,
      "description": "Allow HTTP from Internet to DMZ",
      "enabled": true
    },
    {
      "rule_id": "FW-003",
      "source_zone": "DMZ",
      "destination_zone": "Application",
      "protocol": "TCP",
      "source_port": "ANY",
      "destination_port": "8080",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 20,
      "description": "DMZ reverse proxy to application servers",
      "enabled": true
    },
    {
      "rule_id": "FW-004",
      "source_zone": "Application",
      "destination_zone": "Database",
      "protocol": "TCP",
      "source_port": "ANY",
      "destination_port": "5432",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 30,
      "description": "Application servers to PostgreSQL database",
      "enabled": true
    },
    {
      "rule_id": "FW-005",
      "source_zone": "Admin",
      "destination_zone": "Database",
      "protocol": "TCP",
      "source_port": "ANY",
      "destination_port": "5432",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 35,
      "description": "Admin direct database access",
      "enabled": true
    },
    {
      "rule_id": "FW-006",
      "source_zone": "Admin",
      "destination_zone": "Application",
      "protocol": "TCP",
      "source_port": "ANY",
      "destination_port": "22",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 36,
      "description": "Admin SSH to application servers",
      "enabled": true
    },
    {
      "rule_id": "FW-007",
      "source_zone": "Admin",
      "destination_zone": "DMZ",
      "protocol": "TCP",
      "source_port": "ANY",
      "destination_port": "22",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 37,
      "description": "Admin SSH to DMZ servers",
      "enabled": true
    },
    {
      "rule_id": "FW-008",
      "source_zone": "Guest",
      "destination_zone": "Application",
      "protocol": "ANY",
      "source_port": "ANY",
      "destination_port": "ANY",
      "action": "ALLOW",
      "direction": "INBOUND",
      "priority": 50,
      "description": "MISCONFIGURATION: Guest should not reach Application",
      "enabled": true
    },
    {
      "rule_id": "FW-009",
      "source_zone": "Internet",
      "destination_zone": "Database",
      "protocol": "ANY",
      "source_port": "ANY",
      "destination_port": "ANY",
      "action": "DENY",
      "direction": "INBOUND",
      "priority": 5,
      "description": "Block all direct Internet to Database access",
      "enabled": true
    },
    {
      "rule_id": "FW-010",
      "source_zone": "Guest",
      "destination_zone": "Database",
      "protocol": "ANY",
      "source_port": "ANY",
      "destination_port": "ANY",
      "action": "DENY",
      "direction": "INBOUND",
      "priority": 6,
      "description": "Block all Guest to Database access",
      "enabled": true
    },
    {
      "rule_id": "FW-011",
      "source_zone": "Guest",
      "destination_zone": "Admin",
      "protocol": "ANY",
      "source_port": "ANY",
      "destination_port": "ANY",
      "action": "DENY",
      "direction": "INBOUND",
      "priority": 7,
      "description": "Block Guest access to Admin zone",
      "enabled": true
    },
    {
      "rule_id": "FW-012",
      "source_zone": "Internet",
      "destination_zone": "Admin",
      "protocol": "ANY",
      "source_port": "ANY",
      "destination_port": "ANY",
      "action": "DENY",
      "direction": "INBOUND",
      "priority": 8,
      "description": "Block Internet access to Admin zone",
      "enabled": true
    }
  ]
}
